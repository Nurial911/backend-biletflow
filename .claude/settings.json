{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(./mvnw:*)",
      "Bash(./mvnw.cmd:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)"
    ]
  }
}
