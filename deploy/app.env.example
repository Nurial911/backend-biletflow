# Copy to ~/app/app.env on the VM, fill in the values, then: chmod 600 ~/app/app.env
# Never commit the filled-in file. One KEY=value per line, no quotes, no spaces around "=".
# Every container gets all of these (env_file), so the database and the app share one file.

# --- Database (read by the db container when it first creates the database) ---
POSTGRES_DB=biletflow
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- App's connection to it (same values; "db" is the database container's name) ---
DB_URL=jdbc:postgresql://db:5432/biletflow
DB_USERNAME=
DB_PASSWORD=

# --- Sign-in tokens: at least 64 characters, e.g. from: openssl rand -base64 64 | tr -d '\n' ---
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Web addresses ---
# The frontend's address(es) allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=
# Base of links in emails, calendar entries, Campaign QR codes and Halyk bank returns: the frontend's
# https address. Caddy serves the frontend on the API's own domain (FRONTEND.md), so this is https://<DOMAIN>.
APP_FRONTEND_URL=

# Demo accounts with a publicly known password: never true on a server.
SEED_DATA=false

# Hours after an event ends before its simulated payout is made (placeholder; the SRS leaves it open).
# PAYOUT_DELAY_HOURS=72

# --- Payments: simulated (no bank) or halyk (Halyk ePay test environment) ---
PAYMENT_PROVIDER=simulated
HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
HALYK_TERMINAL_ID=
HALYK_CALLBACK_BASE_URL=

# --- Email: off unless a real SMTP server is configured ---
MAIL_ENABLED=false
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=no-reply@biletflow.kz
